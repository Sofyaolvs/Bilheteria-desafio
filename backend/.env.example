# Banco de dados
DATABASE_URL=postgres://eventos:eventos@localhost:5432/eventos

# JWT
JWT_SECRET=troque-este-segredo-em-produção
JWT_EXPIRES_IN=8h

# Assinatura do QR code do ingresso (HMAC) — troque em produção
TICKET_QR_SECRET=troque-este-segredo-de-qr-em-producao

# Ticketmaster Discovery API (https://developer.ticketmaster.com)
# Se deixar em branco, o backend usa um catálogo local de exemplo (ver src/catalog/fixtures)
TICKETMASTER_API_KEY=

# URL pública do frontend, usada para montar links de compartilhamento de ingresso
FRONTEND_URL=http://localhost:5173

PORT=3000
